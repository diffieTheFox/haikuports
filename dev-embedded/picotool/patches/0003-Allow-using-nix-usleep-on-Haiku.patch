From 714774b4b7511835105384455114d936c9e167d0 Mon Sep 17 00:00:00 2001
From: diffie <haiku-dev@diffie.eu>
Date: Fri, 4 Sep 2026 05:44:39 +0200
Subject: [PATCH 3/3] Allow using *nix usleep() on Haiku

---
 lib/whereami/whereami.c | 34 ++++++++++++++++++++++++++++++++++
 main.cpp                |  4 ++--
 2 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/lib/whereami/whereami.c b/lib/whereami/whereami.c
index d052e14..b85b9b4 100644
--- a/lib/whereami/whereami.c
+++ b/lib/whereami/whereami.c
@@ -166,6 +166,40 @@ int WAI_PREFIX(getModulePath)(char* out, int capacity, int* dirname_length)
   return length;
 }
 
+#elif defined(__HAIKU__)
+
+#include <image.h>
+#include <string.h>
+
+WAI_FUNCSPEC
+int WAI_PREFIX(getExecutablePath)(char* out, int capacity, int* dirname_length)
+{
+	image_info info;
+	int32 cookie = 0;
+
+	while (get_next_image_info(B_CURRENT_TEAM, &cookie, &info) >= B_OK)
+	{
+		if (info.type == B_APP_IMAGE)
+		{
+			size_t len = strlen(info.name);
+			if (dirname_length != NULL)
+				*dirname_length = len;
+			if (len > capacity)
+				memcpy(out, info.name, len + 1);
+			else
+				return -1;
+			return len;
+		}
+	}
+	return -1;
+}
+
+WAI_FUNCSPEC
+int WAI_PREFIX(getModulePath)(char* out, int capacity, int* dirname_length)
+{
+	return -1;
+}
+
 #elif defined(__linux__) || defined(__CYGWIN__) || defined(__sun) || defined(WAI_USE_PROC_SELF_EXE)
 
 #include <stdio.h>
diff --git a/main.cpp b/main.cpp
index 19a9106..ae2af87 100644
--- a/main.cpp
+++ b/main.cpp
@@ -57,7 +57,7 @@
 
 #include "nlohmann/json.hpp"
 
-#if defined(__unix__) || defined(__APPLE__)
+#if defined(__unix__) || defined(__APPLE__) || defined(__HAIKU__)
 #include <unistd.h>
 #endif
 
@@ -10133,7 +10133,7 @@ bool reboot_command::execute(device_map &devices) {
 #endif
 
 static void sleep_ms(int ms) {
-#if defined(__unix__) || defined(__APPLE__)
+#if defined(__unix__) || defined(__APPLE__) || defined(__HAIKU__)
     usleep(ms * 1000);
 #else
     Sleep(ms);
-- 
2.54.0

